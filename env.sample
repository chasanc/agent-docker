# Copy this file to ".env" (gitignored) and fill in the real values.
# Use credentials scoped to only what the agent needs — it runs unattended.

# Claude auth: no API key needed — the runners mount the host's
# `claude login` OAuth credentials into the container.

# GitHub: a PAT (classic or fine-grained) scoped to the repos this agent needs.
GITHUB_TOKEN=

# Jira: Atlassian API token, generated at id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Linear: personal API key, generated in Linear under Settings > API
LINEAR_API_KEY=

# Optional: Claude model for agent runs. Defaults to "sonnet" (latest Sonnet);
# set e.g. "opus" or a full model ID to override.
#AGENT_MODEL=

# AWS: the runners mount the host's ~/.aws read-only at /home/agent/.aws, so
# credentials/profiles are NOT copied here. Only non-secret selectors go in .env.
# Point this at an IAM identity scoped to what the agent actually needs.
#AWS_PROFILE=default
#AWS_REGION=
# To withhold AWS access entirely, or to mount a different (e.g. agent-only)
# credentials directory, set AGENT_MOUNT_AWS=0 / AGENT_AWS_DIR=<path> in the
# SHELL environment of the runner (like AGENT_DOCKER_CONTEXT) — those two are
# read by run-task.sh / run-nightly.sh directly, not from this file.

# Workspaces: each task gets its own directory under ~/agent-docker-workspace,
# pruned after 7 days. AGENT_WORKSPACE / AGENT_WORKSPACE_ROOT /
# AGENT_WORKSPACE_RETENTION_DAYS / AGENT_WORKSPACE_RESET are read by the
# runners themselves, so they belong in the SHELL environment or in a plan's
# own "<plan>.env" — not in this file, which only populates container env.

# Optional: git identity for commits made inside the container.
# Defaults (see entrypoint.sh): "Claude Agent" / claude-agent@example.invalid
#GIT_USER_NAME=
#GIT_USER_EMAIL=
